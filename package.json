{
	"name": "youtubefancybox",
	"version": "3.0.2",
	"private": true,
	"files": [
		"inc/**/*",
		"build/**/*",
		"languages/**/*",
		"vendor/**/*",
		"composer.json",
		"composer.lock",
		"*.php",
		"readme.*",
		"license.*"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/milindmore22/youtubefancybox.git"
	},
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=10.0.0"
	},
	"dependencies": {
		"@wordpress/block-editor": "^14.14.6",
		"@wordpress/blocks": "^14.8.2",
		"@wordpress/components": "^40.0.0",
		"@wordpress/element": "^6.40.0",
		"@wordpress/i18n": "^6.13.0",
		"@wordpress/icons": "^11.7.0"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@wordpress/babel-preset-default": "^8.40.0",
		"@wordpress/browserslist-config": "^6.40.0",
		"@wordpress/eslint-plugin": "^24.2.0",
		"@wordpress/scripts": "^31.5.0",
		"browserslist": "^4.28.1",

		"cross-env": "^10.1.0",
		"css-minimizer-webpack-plugin": "^8.0.0",
		"eslint": "^8.57.1",
		"eslint-plugin-eslint-comments": "^3.2.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jest": "^27.9.0",
		"globals": "^17.3.0",
		"npm-run-all": "^4.1.5",
		"rimraf": "^6.1.3",
		"webpack-remove-empty-scripts": "^1.1.1"
	},
	"scripts": {
		"build:dev": "cross-env NODE_ENV=development npm-run-all 'build:!(dev|prod)'",
		"build:js": "wp-scripts build --config ./webpack.config.js",
		"build:prod": "npm run clean && cross-env NODE_ENV=production npm-run-all 'build:!(dev|prod)' && composer install --no-dev --optimize-autoloader",
		"clean": "rimraf build",
		"i18n:make-pot": "wp i18n make-pot . languages/youtubefancybox.pot --exclude=node_modules --exclude=vendor",
		"lint:css": "wp-scripts lint-style",
		"lint:css:fix": "wp-scripts lint-style --fix",
		"lint:js:fix": "npm run lint:js -- --fix",
		"lint:js": "wp-scripts lint-js",
		"lint:php:fix": "composer run-script format",
		"lint:php:stan": "composer run-script phpstan",
		"lint:php": "composer run-script lint",
		"lint": "npm-run-all --parallel lint:*",
		"plugin-zip": "npm run build:prod && wp-scripts plugin-zip",
		"start:js": "wp-scripts start --config ./webpack.config.js",
		"start": "npm-run-all --parallel start:*",
		"test:php": "composer run-script test"
	},
	"overrides": {
		"eslint": "^8.57.1",
		"minimatch": ">=3.1.3",
		"serialize-javascript": ">=7.0.3",
		"webpack-dev-server@<=5.2.0": ">=5.2.1"
	}
}
